diff --git a/iokit/Kernel/arm/SWEETStorage.cpp b/iokit/Kernel/arm/SWEETStorage.cpp
--- /dev/null
+++ b/iokit/Kernel/arm/SWEETStorage.cpp
new file mode 100644
@@ -0,0 +1,50 @@
+/*
+ * SWEET storage driver for Qualcomm SDM732G UFS controller.
+ * For SDM632 (onclite), this needs to be replaced with an eMMC driver.
+ * See docs/HARDWARE.md in the port project for eMMC controller details.
+ */
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class SweetStorage : public IOStorage {
+	OSDeclareDefaultStructors(SweetStorage);
+
+public:
+	virtual bool init(OSDictionary *dictionary) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	virtual bool read(uint64_t block, IOStorageExtent *extent, IOStorageClient *client) APPLE_KEXT_OVERRIDE;
+	virtual bool write(uint64_t block, IOStorageExtent *extent, IOStorageClient *client) APPLE_KEXT_OVERRIDE;
+	virtual void getCapabilities(IOStorage::Capabilities &caps) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetStorage, IOStorage);
+
+bool SweetStorage::init(OSDictionary *dictionary) {
+	if (!super::init(dictionary)) return false;
+	return true;
+}
+
+bool SweetStorage::start(IOService *provider) {
+	if (!super::start(provider)) return false;
+	registerService();
+	return true;
+}
+
+void SweetStorage::stop(IOService *provider) {
+	super::stop(provider);
+}
+
+bool SweetStorage::read(uint64_t block, IOStorageExtent *extent, IOStorageClient *client) {
+	// TODO: Implement UFS read
+	return false;
+}
+
+bool SweetStorage::write(uint64_t block, IOStorageExtent *extent, IOStorageClient *client) {
+	// TODO: Implement UFS write
+	return false;
+}
+
+void SweetStorage::getCapabilities(IOStorage::Capabilities &caps) {
+	memset(&caps, 0, sizeof(caps));
+	caps.version = kIOStorageCapabilitiesVersion1;
+	caps.read = 1;
+	caps.write = 1;
+	caps.totalBytes = 32ULL * 1024 * 1024 * 1024; // 32GB eMMC
+	caps.blockSize = 512;
+	caps.optimalIOSize = 4096;
+}
+
+OSDefineMetaClassAndStructors(SweetStorage, IOStorage);
+#endif /* SWEET */
